{
  "version": 2,
  "name": "commfit-tech",
  "buildCommand": "pnpm --filter @commfit/tech build",
  "outputDirectory": "apps/tech/.next",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "framework": "nextjs",
  "regions": ["iad1"],
  "env": {
    "NEXT_PUBLIC_SENTRY_DSN": "@commfit-tech-sentry-dsn",
    "SENTRY_DSN": "@commfit-tech-sentry-dsn",
    "SENTRY_ORG": "@commfit-sentry-org",
    "SENTRY_AUTH_TOKEN": "@commfit-sentry-auth-token",
    "NEXT_PUBLIC_SUPABASE_URL": "@commfit-supabase-url",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "@commfit-supabase-anon-key",
    "NEXT_PUBLIC_API_URL": "@commfit-tech-api-url"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
