# Database
DATABASE_URL=postgresql://commfit:commfit@localhost:5432/commfit

# Redis
REDIS_URL=redis://localhost:6379

# App
NODE_ENV=development
PORT=3000

# Worker health-check port
# Default is 3001, but that collides with apps/ops Next.js dev server when running fully native.
# Use 3010 here for native `pnpm dev`. Docker Compose overrides this inside the container automatically.
WORKER_PORT=3010

# API CORS origins (comma-separated, no trailing slashes)
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003

# Sentry (leave empty to disable)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Bull-Board admin key
BULL_BOARD_ADMIN_KEY=change-me-locally

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# API URL for frontends
NEXT_PUBLIC_API_URL=http://localhost:3000
